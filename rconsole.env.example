# Copy to /etc/rconsole.env (owner root, mode 600).
RCON_PASSWORD=change-me
#RCON_HOST=127.0.0.1
#RCON_PORT=25575

# Listen on all interfaces, port 80, for the reverse proxy.
WEB_HOST=0.0.0.0
WEB_PORT=80

# IP(s) of your reverse proxy, comma-separated. Only these may set
# X-Forwarded-For / X-Forwarded-Proto (real client IP, Secure cookies).
TRUST_PROXY=10.10.7.1

MC_DIR=/srv/minecraft
BACKUP_DIR=/srv/minecraft-backups
BACKUP_KEEP=10

# rconsole's own URL (notification links, single sign-on redirect).
#PUBLIC_URL=https://rconsole.example.com

# Single sign-on with authentik (or Keycloak, Auth0, any OpenID Connect provider).
# Redirect URI to register at the provider: $PUBLIC_URL/auth/oidc/callback
#OIDC_ISSUER=https://auth.example.com/application/o/rconsole/
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_NAME=authentik
# Provider groups for each role (defaults shown).
#OIDC_ADMIN_GROUPS=rconsole-admins
#OIDC_MODERATOR_GROUPS=rconsole-moderators
#OIDC_VIEWER_GROUPS=rconsole-viewers
# off: SSO only (local accounts can't sign in from the web).
#LOCAL_LOGIN=on
