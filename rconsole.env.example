# Copy to /etc/rconsole.env (owner root, mode 600).
RCON_PASSWORD=change-me
#RCON_HOST=127.0.0.1
#RCON_PORT=25575

# Listen on all interfaces, port 80, for the reverse proxy.
WEB_HOST=0.0.0.0
WEB_PORT=80

# IP(s) of your reverse proxy, comma-separated. Only these may set
# X-Forwarded-For / X-Forwarded-Proto (real client IP, Secure cookies).
TRUST_PROXY=10.10.7.1

MC_DIR=/srv/minecraft
BACKUP_DIR=/srv/minecraft-backups
BACKUP_KEEP=10
