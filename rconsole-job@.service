# Offline helper job (backup, restore, world delete, server.properties),
# started by rconsole; the request is BACKUP_DIR/.requests/%i.json.
# Runs as the Minecraft user because world files are owner-readable only.
[Unit]
Description=rconsole job %i

[Service]
Type=oneshot
User=minecraft
Group=minecraft
UMask=0027
EnvironmentFile=/etc/rconsole.env
Environment=UV_USE_IO_URING=0
ExecStart=/usr/bin/node /opt/rconsole/bin/mc-helper.js job %i
TimeoutStartSec=60min
Nice=10
IOSchedulingClass=idle

ReadWritePaths=/srv/minecraft /srv/minecraft-backups
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
