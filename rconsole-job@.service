# Offline helper job (backup, restore, world delete, server.properties),
# started by rconsole; the request is BACKUP_DIR/.requests/%i.json.
# Runs as the Minecraft user because world files are owner-readable only.
[Unit]
Description=rconsole job %i

[Service]
Type=oneshot
User=minecraft
Group=minecraft
UMask=0027
EnvironmentFile=/etc/rconsole.env
# The helper needs the folder settings only. rconsole's secrets stay out of
# its environment: it runs as the Minecraft user, like the servers, and
# test/units.test.js checks that every secret rconsole reads is listed here.
UnsetEnvironment=RCON_PASSWORD OIDC_CLIENT_SECRET METRICS_TOKEN NTFY_TOKEN OFFSITE_ACCESS_KEY_ID OFFSITE_SECRET_ACCESS_KEY OFFSITE_PASSPHRASE
Environment=UV_USE_IO_URING=0
ExecStart=/usr/bin/node /opt/rconsole/bin/mc-helper.js job %i
TimeoutStartSec=60min
# Backups and restores compress and copy a whole world: they get what the
# server leaves over. Nice only ranks processes inside one unit; the
# weights rank this unit against minecraft.service.
Nice=10
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10

ReadWritePaths=/srv/minecraft /srv/minecraft-backups -/srv/minecraft-servers
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
