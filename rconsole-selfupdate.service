[Unit]
Description=Update rconsole from its git remote
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Root: writes /opt/rconsole, installs changed unit files and restarts
# rconsole. The script takes no input from rconsole; see bin/self-update.sh.
ExecStart=/bin/bash /opt/rconsole/bin/self-update.sh
Environment=RCONSOLE_DIR=/opt/rconsole RCONSOLE_BRANCH=main STATE_DIR=/var/lib/rconsole
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
