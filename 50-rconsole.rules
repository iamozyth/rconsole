// /etc/polkit-1/rules.d/50-rconsole.rules
// Lets the rconsole user start its helper jobs, start its own updater, and
// start/stop/restart the Minecraft service and the servers it installed
// (rconsole-mc@<id>). Nothing else.
polkit.addRule(function (action, subject) {
  if (action.id !== "org.freedesktop.systemd1.manage-units" || subject.user !== "rconsole") return;
  var unit = action.lookup("unit");
  var verb = action.lookup("verb");
  if (verb === "start" && /^rconsole-(job|net)@[a-f0-9]{32}\.service$/.test(unit)) return polkit.Result.YES;
  if (verb === "start" && unit === "rconsole-selfupdate.service") return polkit.Result.YES;
  // Legacy units from rconsole 1.x, kept until they are removed.
  if (verb === "start" && /^rconsole-(backup|update)@[A-Za-z0-9._-]+\.service$/.test(unit)) return polkit.Result.YES;
  if (/^rconsole-mc@[a-z0-9][a-z0-9-]{0,31}\.service$/.test(unit) && (verb === "start" || verb === "stop" || verb === "restart")) return polkit.Result.YES;
  // Change "minecraft.service" here if MC_SERVICE differs.
  if (unit === "minecraft.service" && (verb === "start" || verb === "stop" || verb === "restart")) return polkit.Result.YES;
});
